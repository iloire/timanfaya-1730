{
  "name": "timanfaya-1730",
  "version": "0.1.0",
  "description": "The 1730–1736 eruption of Timanfaya replayed on the real terrain of Lanzarote (three.js)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fetch-lava": "tsx scripts/fetch-lava.ts",
    "fetch-terrain": "tsx scripts/fetch-terrain.ts"
  },
  "type": "module",
  "dependencies": {
    "proj4": "2.22.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/proj4": "2.5.6",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "geotiff": "3.0.5",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "private": true
}
